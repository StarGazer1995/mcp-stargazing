        },
        "pm10_ug_m3": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pm10 Ug M3"
        },
        "pm2_5_ug_m3": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
