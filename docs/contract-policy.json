{
  "policy_version": 2,
  "target_release": "1.0.0",
  "schema_baseline": "tests/public_contract_v1.json",
  "minimum_notice_days": 90,
  "minimum_subsequent_minor_releases": 2,
  "removal_requires_next_major": true,
  "compatibility_tools": [
    "get_best_stargazing_plan",
    "get_multiday_stargazing_plan"
  ],
  "deprecations": [],
  "compatible_extensions": [
    {
      "id": "weather-atmosphere-v1",
      "payload": "AggregatedWeatherResponse",
      "schema_extension": "tests/weather_atmosphere_contract.json",
      "review": "docs/weather-atmosphere-contract.md",
      "added_optional_fields": {
        "CurrentWeather": ["atmosphere"],
        "HourlyForecastItem": ["atmosphere"],
        "NormalizedWeatherData": ["atmosphere_sources"],
        "WeatherSummary": ["atmosphere_sources"]
      },
      "historical_baselines_unchanged": true
    }
  ]
}
